# Digital Review AI — environment variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env, .env.local, or any file containing real secrets.

# --- Supabase (required for Module 1) ------------------------------------
# Project URL and anon/public key, found in Supabase Project Settings > API.
# The anon key is safe to expose to the browser — Row Level Security is
# what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key bypasses Row Level Security entirely. It must only
# ever be used in trusted server-side code (never in a Client Component,
# never sent to the browser, never prefixed with NEXT_PUBLIC_). Module 1
# does not use it anywhere yet — it is documented here so the pattern is
# established before it's ever needed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Future modules (placeholders only — not used yet) --------------------
# AI provider key for the Review Assistant. Optional even in Module 2: the
# feedback flow always works via a deterministic template with no key set.
# When set, it must be a valid Anthropic API key — used only server-side in
# src/lib/ai/reviewDraft.ts to lightly polish (never invent) a draft.
AI_PROVIDER_API_KEY=

# Google Places API key for the "find your Google review link" lookup
# (Module 4). Optional: without it, the business profile page shows an
# honest "not configured" message and owners paste their review link
# manually — nothing pretends this feature works when it doesn't. When
# set, used only server-side in src/lib/google/placesLookup.ts.
GOOGLE_PLACES_API_KEY=

# Payment provider keys for billing/subscriptions (Module 6).
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
